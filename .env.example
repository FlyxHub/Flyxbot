# Required: the bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: command prefix (default ">")
COMMAND_PREFIX=>

# Optional: the user who gets DM alerts when a message mentioning them is edited
# or deleted. Defaults to the original owner - set it if you run your own copy.
OWNER_USER_ID=307688449811415041

# Optional: Channel Flashback. Every day at 9AM (in FLASHBACK_TIMEZONE, an IANA
# name like America/Chicago), repost a message from this date in each earlier
# year of FLASHBACK_CHANNEL_ID into FLASHBACK_TARGET_CHANNEL_ID. Off unless both
# channel IDs are set.
FLASHBACK_CHANNEL_ID=
FLASHBACK_TARGET_CHANNEL_ID=
FLASHBACK_TIMEZONE=UTC
