# Required: the bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: command prefix (default ">")
COMMAND_PREFIX=>

# Optional: guild-specific IDs. These default to the original guild's values,
# so only set them if you are moving the bot to a different server.

# Restriction role: holding it REMOVES the ability to post images.
NO_IMAGES_ROLE_ID=1041203946817081365
# Role that gates takeimg / giveimg / modroulette / sm.
MODERATOR_ROLE_ID=1042085580034539580
# Role whose send_messages is toggled by "ld enable" / "ld disable".
LOCKDOWN_ROLE_ID=1036799478608429116
# User who gets DM alerts when a message mentioning them is edited or deleted.
OWNER_USER_ID=307688449811415041
# Users given the restriction role the moment they join (space or comma separated).
JOIN_BLACKLIST=787885272594513950,514143503471738910
